# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# MongoDB Atlas connection string (server-side only)
MONGODB_URI=""

# Brevo API key and list ID for newsletter & transactional emails (server-side only)
BREVO_API_KEY=""
BREVO_LIST_ID=""

# Long random secret phrase for signing httpOnly admin session cookies (server-side only)
SESSION_SECRET=""

# Notification recipient email for bookings, community moderation alerts, and password resets
NOTIFY_EMAIL="bitznbrainsco@gmail.com"
